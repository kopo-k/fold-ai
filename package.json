{
  "name": "fold-ai",
  "version": "0.1.0",
  "description": "Browser extension that makes long AI chat answers collapsible.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "package": "node scripts/package.mjs",
    "build:safari": "node scripts/build-safari.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.47.2",
    "@types/node": "^22.7.4",
    "@types/webextension-polyfill": "^0.12.1",
    "@vitest/coverage-v8": "^2.1.2",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.1",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
